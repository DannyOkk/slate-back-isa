# Compose
PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DDL_AUTO=update

# Base de datos PostgreSQL
POSTGRES_DB=slate_db
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/slate_db
DB_USER=postgres
DB_PASSWORD=tu_contrasenia_segura
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Seguridad JWT (el secreto debe tener al menos 256 bits / 32 caracteres)
JWT_SECRET=clave_secreta_para_firmar_tokens_jwt_minimo_256_bits
JWT_EXPIRATION_MS=86400000

# Azure: no colocar credenciales aquí. Usar GitHub Actions Secrets.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
