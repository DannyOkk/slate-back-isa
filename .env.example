# Compose
PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DDL_AUTO=update

# Base de datos PostgreSQL
POSTGRES_DB=slate_db
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/slate_db
DB_USER=postgres
DB_PASSWORD=tu_contrasenia_segura
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Seguridad JWT (el secreto debe tener al menos 256 bits / 32 caracteres)
JWT_SECRET=clave_secreta_para_firmar_tokens_jwt_minimo_256_bits
JWT_EXPIRATION_MS=86400000

# Azure: no colocar credenciales aquí. Usar GitHub Actions Secrets.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=

# Script local opcional: usa estos defaults seguros para Slate si se omiten.
# Si no se indican credenciales Azure, el script usa la sesión existente de `az login`.
# RESOURCE_GROUP=universidad
# ACR_NAME=acringenieria
# CONTAINERAPP_ENVIRONMENT=slate-isa
# CONTAINERAPP_NAME=slate-back-isa
# IMAGE_NAME=slate-backend
# IMAGE_TAG=local
# TARGET_PORT=8080
# MIN_REPLICAS=0
# MAX_REPLICAS=1
